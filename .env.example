# SMTP Configuration for Email Sending
# These credentials will be provided by your email hosting provider

# SMTP Server Host (e.g., smtp.gmail.com, smtp.office365.com, mail.yourdomain.com)
SMTP_HOST=your_smtp_host

# SMTP Port (usually 587 for TLS, 465 for SSL, 25 for non-secure)
SMTP_PORT=587

# Use secure connection (true for port 465, false for port 587)
SMTP_SECURE=false

# SMTP Authentication Username (usually your email address)
SMTP_USER=tyres@streatmotors.co.uk

# SMTP Authentication Password
SMTP_PASSWORD=your_smtp_password

# From Email Address (the address that appears in the "From" field)
SMTP_FROM=tyres@streatmotors.co.uk
